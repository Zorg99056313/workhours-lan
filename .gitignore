# ============================================================
# 研发工时统计系统 · Git 忽略规则
# ============================================================
# 原则：源码/文档/样例进版本库；运行数据、产物、临时文件、二进制一律不进。
# ============================================================

# ---------------- 运行数据（绝对不能进 git）----------------
# 数据库里有真实的账号、密码哈希、工时记录
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal
timesheet.db*

# 报表输出与备份（每次运行都会变）
输出/*
!输出/.gitkeep
备份/*
!备份/.gitkeep

# 运行日志
启动日志.txt
_boot.log
out_*.txt
*.log

# ---------------- Python 临时文件 ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------- 自检/调试临时目录 ----------------
_selftest_tmp/
_selftest_*/
_t_*/
_gen_tmp/
_t_auxcheck*/
_piptmp/
.pytest_cache/
.mypy_cache/

# ---------------- 打包产物（用 Release 或网盘发布，不进库）----------------
# 安装包与绿色版各 12MB，放 git 会让仓库迅速膨胀且无法 diff
*.exe
*.zip
*.rar
*.7z
!工具/*.bat

# ---------------- 打包用的运行时（可由 make_runtime.py 重新生成）----------------
_build/runtime/
_build/payload/
_build/payload.zip
_build/e2e/

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
